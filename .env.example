# Default local Ollama model. One Qwen3.5 4B model handles text and images.
EVAL_PROVIDER=ollama
EVAL_MODEL=qwen3.5:4b
EVAL_MODEL_URL=http://127.0.0.1:11434

# To reuse a running local MLX OpenAI-compatible server instead:
# EVAL_PROVIDER=mlx
# EVAL_MODEL=models/Qwen3.5-4B-MLX-4bit
# EVAL_MODEL_URL=http://127.0.0.1:YOUR_LOCAL_PORT

# Optional PP-OCRv5 service from the earlier project (Fast OCR).
# Without it, use Accurate OCR or enter/correct the transcript manually.
PADDLE_OCR_URL=http://127.0.0.1:8001/ocr

# Optional local database/upload directory: EVAL_DATA_DIR=./data
